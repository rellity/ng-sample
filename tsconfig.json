{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "files": [
    "src/main.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
